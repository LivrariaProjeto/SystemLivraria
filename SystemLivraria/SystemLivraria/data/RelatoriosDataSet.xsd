<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  id="RelatoriosDataSet"
  targetNamespace="http://tempuri.org/RelatoriosDataSet.xsd"
  xmlns="http://tempuri.org/RelatoriosDataSet.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
  elementFormDefault="qualified">

	<xs:element name="RelatoriosDataSet"
				msdata:IsDataSet="true"
				msdata:UseCurrentLocale="true">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">

				<xs:element name="MovimentoEstoque">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Data" type="xs:dateTime" minOccurs="0"/>
							<xs:element name="Tipo" type="xs:string" minOccurs="0"/>
							<xs:element name="Documento" type="xs:string" minOccurs="0"/>
							<xs:element name="Descricao" type="xs:string" minOccurs="0"/>
							<xs:element name="Complemento" type="xs:string" minOccurs="0"/>
							<xs:element name="Entrada" type="xs:int" minOccurs="0"/>
							<xs:element name="Saida" type="xs:int" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="Financeiro">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Data" type="xs:dateTime" minOccurs="0"/>
							<xs:element name="Tipo" type="xs:string" minOccurs="0"/>
							<xs:element name="Documento" type="xs:string" minOccurs="0"/>
							<xs:element name="Descricao" type="xs:string" minOccurs="0"/>
							<xs:element name="Complemento" type="xs:string" minOccurs="0"/>
							<xs:element name="Entrada" type="xs:decimal" minOccurs="0"/>
							<xs:element name="Saida" type="xs:decimal" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>
